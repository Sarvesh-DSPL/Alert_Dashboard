# Copy this file to .env and configure your MySQL connection.

# Option 1: full connection URL (overrides individual vars below)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/smart_facility_monitoring

# Option 2: individual MySQL variables
MYSQL_USER=root
MYSQL_PASSWORD=DsplSql2004
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smart_facility_monitoring

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:4200
